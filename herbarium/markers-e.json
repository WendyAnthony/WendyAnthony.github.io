{ "Accession" : "46229",   "Family": "Primulaceae",  "ScientificName": "Lysimachia daphnoides (A. Gray) Hillebr.   "  , "lat":  "22.15" , "lng":  "-159.6" , "Locality" : "Island of Kauai, Kokee; Alakai 'second' bog and beyond.",  "Ecology" : "In montane wet sedgelands, usually restricted to low hummocks slightly hgher than the surrounding vegetation. With Oreobolus, Rhynchospora, Carex, Panicum, Metrosideros, Cheirodendron, Melicope, Dubautia, Cibotium, Dicranopteris, Adenophorus, Vaccinium, Styphelia, Viola, Lycopodium, and Coprosma. Erect, upright shrubs usually less than 1 m tall. Entire plant usually densely viscid-hirtellous especially when younger. Upper leaf surface light green, lighter lower; base of lamina, primary vein and, sometimes secondary veins red. Calyx lobes green, sometimes red at base. Corolla lobes dark maroon to salmon pink.",   "GeoSecondary" : "Kauai",  "GeoPrimary" : "Hawaii", "Country" : "United States of America",  "Continent" : "North America"},
{ "Accession" : "46230",   "Family": "Primulaceae",  "ScientificName": "Lysimachia glutinosa Rock   "  , "lat":  "22.15" , "lng":  "-159.6333333333333333" , "Locality" : "Island of Kauai, Kokee. Below Kalalau Lookout.",  "Ecology" : "North facing slope in open forest with Metrosideros, Dicranopteris, Scaevola, and Dodonaea. Sprawling shrub with stems up to 2.5 m long. Leaves light green above and below. Entire plant sticky, glabrous. Corolla white, sometimes reddish tinged at base.",   "GeoSecondary" : "Kauai",  "GeoPrimary" : "Hawaii", "Country" : "United States of America",  "Continent" : "North America"},
