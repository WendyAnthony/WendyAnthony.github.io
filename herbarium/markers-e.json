{ "Accession" : "40760",   "Family": "Liliaceae",  "ScientificName": "Erythronium grandiflorum Pursh   "  , "lat":  "50.6152777777777778" , "lng":  "-118.9333333333333333" , "Locality" : "Ashton Creek Forest Service Road, 600 m past 18 km marker.",  "Ecology" : "Scattered in old cut area of Abies lasiocarpa (currently grazed), with Ribes sp., Claytonia lanceolata, Veratrum viride, Valeriana sitchensis, Mitella breweri, Trollius laxus, Castilleja sp., Pedicularis bracteosa Heracleum lanatum, Epilobium angustifolium, Viola glabella, Thalictrum sp., Senecio triangularis.  S exp.  Frequent bulb-appendages evident; two-leaved plant here may have originated as on offset from yellow-anthered specimen.",   "GeoSecondary" : "",  "GeoPrimary" : "British Columbia", "Country" : "Canada",  "Continent" : "North America"},
