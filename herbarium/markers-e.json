{ "Accession" : "40743",   "Family": "Liliaceae",  "ScientificName": "Erythronium grandiflorum Pursh   "  , "lat":  "50.8088888888888889" , "lng":  "-119.7419444444444444" , "Locality" : "Neskonlith Meadows (Chase area). On Sahhaltkum IR 4, ~560 m from Niskonlith Lake road along trail to Aylmer Lake.",  "Ecology" : "W exp. Slope 15 deg.  Very abundant in meadow (patches of Pseudotsuga menziesii and Populus tremuloides in the area); with Rosa woodsii, Balsamorhiza sagittata, Achillea millefolium, Delphinium nuttallianum, Claytonia lanceolata, Lupinus sericeus, Ranunculus glaberrimus, Fritillaria pudica.  [voucher for M.Sc. Thesis by D. Loewen, Department of Biology, University of Victoria, 1998].",   "GeoSecondary" : "",  "GeoPrimary" : "British Columbia", "Country" : "Canada",  "Continent" : "North America"},
