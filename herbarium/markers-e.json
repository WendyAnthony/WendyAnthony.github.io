{ "Accession" : "46233",   "Family": "Primulaceae",  "ScientificName": "Lysimachia kalalauensis Skottsb.   "  , "lat":  "22.075" , "lng":  "-159.6166666666666667" , "Locality" : "Island of Kauai, Waialae Ridge, upslope from upper falls on Waialae River.",  "Ecology" : "Collected from a population of more than 40 individuals growing on north facing slope in diverse mesic forest with Metrosideros, Acacia, Bidens, Melicope, Styphelia, Dodonaea, Psychotria, Dubautia, Hedyotis, and Pleomele. Sprawling shrub, with stems up to 4 m long. Leaves dark green above, much lighter below, often silvery when young, veins reddish. Young stems brown pubescent, usually glabrate. Pedicels pendulous, twisting upright in fruit.",   "GeoSecondary" : "Kauai",  "GeoPrimary" : "Hawaii", "Country" : "United States of America",  "Continent" : "North America"},
{ "Accession" : "46234",   "Family": "Primulaceae",  "ScientificName": "Lysimachia kalalauensis Skottsb.   "  , "lat":  "22.1416666666666667" , "lng":  "-159.6333333333333333" , "Locality" : "Island of Kauai, Kokee. Near Awaawapuhi trail one mile marker on north facing slope into Awaawapuhi Valley.",  "Ecology" : "Collected from a population of more than 60 individuals and many seedlings in lowland diverse mesic forest with Metrosideros, Dodonaea, Styphelia, Vaccinium, Scaevola, Dubautia, Alyxia, Dianella and Wilkesia. Sprawling shrub, with stems up to 4 m long. Leaves dark green above, much lighter below, often silvery when young, veins reddish. Young stems brown pubescent, usually glabrate. Pedicels pendulous, twisting upright in fruit. Corolla green, veins and base reddish.",   "GeoSecondary" : "Kauai",  "GeoPrimary" : "Hawaii", "Country" : "United States of America",  "Continent" : "North America"},
{ "Accession" : "46235",   "Family": "Primulaceae",  "ScientificName": "Lysimachia kalalauensis Skottsb.   "  , "lat":  "22.15" , "lng":  "-159.6666666666666667" , "Locality" : "Island of Kauai, Kokee. Near Honopu Trail on north facing slope of Honopu Valley.",  "Ecology" : "Collected from a population of more than approx. 150 individuals and many seedlings in lowland diverse mesic forest with Metrosideros, Dodonaea, Dubautia, Cheirodendron, Xylosma, Acacia, Nestigis, Melicope, Tetraplasandra, Alyxia, Psychotria, Styphelia and Wikstroemia.  Sprawling shrub, with stems up to 4 m long. Leaves dark green above, much lighter below, often silvery when young, veins reddish. Young stems brown pubescent, usually glabrate. Pedicels pendulous, twisting upright in fruit.",   "GeoSecondary" : "Kauai",  "GeoPrimary" : "Hawaii", "Country" : "United States of America",  "Continent" : "North America"},
{ "Accession" : "46236",   "Family": "Primulaceae",  "ScientificName": "Lysimachia ovoidea St. John   "  , "lat":  "22.2083333333333333" , "lng":  "-159.5666666666666667" , "Locality" : "Island of Kauai, ridgetop between Wainiha Pali and Manoa Stream; 100m SW of Kulanaililia.",  "Ecology" : "Collected from a population of at least 20 individuals in a lowland wet forest with Metrosideros, Dicranopteris, Melicope, Psychotria, Alyxia, Lobelia, Acacia, Freycinetia, Antidesma, Cibotium, Syzigium, Pittosporum, Wikstroemia, Bidens, Canthium, Hedyotis, and Hibiscus. Plant a sprawling shrub, with stems up to 3 m long. Leaves light green above and below, primary vein and petiole dark red. Entire plant glabrous. Pedicels red, pendulous, twisting upright in fruit. Corolla and calyx maroon red.",   "GeoSecondary" : "Kauai",  "GeoPrimary" : "Hawaii", "Country" : "United States of America",  "Continent" : "North America"},
{ "Accession" : "46222",   "Family": "Primulaceae",  "ScientificName": "Lysimachia pendens Marr   "  , "lat":  "22.0666666666666667" , "lng":  "-159.4916666666666667" , "Locality" : "Island of Kauai, at headwaters of the north fork of the Wailua River.",  "Ecology" : "Growing on vertical wet, mossy or rocky cliffs with Machaerina, Isachne, Bidens, Selaginella, Plantago, Hedyotis, Pipturus, Cyrtandra, Dubautia, Athyrium, and Metrosideros. Occuring as small, many-branched, delicately pendulous or prostrate shrubs; stems 20-60 mm long, densely tan tomentose when young, glabrate. Leaves green above and below. Calyx lobes green, corolla loves red.",   "GeoSecondary" : "Kauai",  "GeoPrimary" : "Hawaii", "Country" : "United States of America",  "Continent" : "North America"},
{ "Accession" : "46398",   "Family": "Primulaceae",  "ScientificName": "Lysimachia remyi  ssp. caliginis (St. John) Marr"  , "lat":  "20.7583333333333333" , "lng":  "-156.2166666666666667" , "Locality" : "Island of Maui (east); Haleakala National park; W side of Koolau Gap; common at and below treeline in montane wet forest dominated by Metrosideros, Styphelia, Blechnum, Coprosma, Vaccinium, Dubautia, Cheirodendron and Macherina",  "Ecology" : "Upright shrubs, sometimes sprawling, often growing in dense clumps with stems up to 2.5m long. Leaves sometimes alternate , but often whorled, with up to 5 leaves per whorl, lanceolate to ovate, coriaceous, undulate, rugose, the margins revolute, dark green above, lighter below with pellucid veins. Calyx lobes often dark red toward base, otherwise green with prominent red veins. Corolla lobes dark red.",   "GeoSecondary" : "Haleakala National Park, Maui",  "GeoPrimary" : "Hawaii", "Country" : "United States of America",  "Continent" : "North America"},
{ "Accession" : "46399",   "Family": "Primulaceae",  "ScientificName": "Lysimachia remyi  ssp. kipahuluensis (St. John) Marr"  , "lat":  "20.7416666666666667" , "lng":  "-156.2" , "Locality" : "Island of Maui (east); Haleakala National park; E side of Koolau Gap; common on slopes above  Waikau Cabin site",  "Ecology" : "Population that appears to be a hybrid swarm of this species and subsp. Caliginis based on wide range in leaf size and shape, varying from lanceolate to ovate. Sprawling shrubs with stems usally less than 1m tall. Leaves light to dark green, above, lighter below, secondary veins pellucid in some, tertiary veins usually obscured by thick cuticle. Calyx lobes occassionally red at base, otherwise green, corolla lobes red, much lighter toward margins, the veins red. Growing with low shrubs dominated by Styphelia, Blechnum, Coprosma, Vaccinium and Holcus.",   "GeoSecondary" : "Haleakala National Park, Maui",  "GeoPrimary" : "Hawaii", "Country" : "United States of America",  "Continent" : "North America"},
